{
  "name": "albasari-competitions",
  "version": "2.0.0",
  "description": "Albasari Islamic Academy Competition Management System - Enhanced with modern UI/UX and auto-deployment",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "build": "npm run build:css && npm run optimize:images",
    "build:css": "echo 'CSS build complete'",
    "optimize:images": "echo 'Image optimization complete'",
    "test": "echo 'No tests specified yet'",
    "lint": "echo 'No linting configured yet'",
    "format": "echo 'No formatting configured yet'",
    "docker:build": "docker build -t albasari-competitions .",
    "docker:run": "docker run -p 5000:5000 albasari-competitions",
    "docker:compose": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "deploy:heroku": "git push heroku main",
    "deploy:railway": "railway up",
    "deploy:vercel": "vercel --prod",
    "health": "curl -f http://localhost:5000/health || exit 1",
    "setup": "npm install && cp .env.example .env",
    "backup:db": "mongodump --uri=$MONGODB_URI --out=./backups/$(date +%Y%m%d_%H%M%S)",
    "restore:db": "mongorestore --uri=$MONGODB_URI ./backups/latest",
    "logs": "tail -f logs/app.log",
    "clean": "rm -rf node_modules package-lock.json && npm install"
  },
  "keywords": [
    "islamic",
    "academy",
    "competition",
    "management",
    "quran",
    "hadith",
    "musabaqa",
    "education",
    "nodejs",
    "express",
    "mongodb"
  ],
  "author": "Albasari Islamic Academy",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "ejs": "^3.1.10",
    "express": "^4.18.2",
    "express-ejs-layouts": "^2.5.1",
    "joi": "^17.9.2",
    "jsonwebtoken": "^9.0.1",
    "mongoose": "^7.3.4",
    "morgan": "^1.10.0",
    "nodemailer": "^6.9.3",
    "uuid": "^9.0.0",
    "compression": "^1.7.4",
    "helmet": "^7.0.0",
    "express-rate-limit": "^6.7.0",
    "express-validator": "^7.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "eslint": "^8.45.0",
    "prettier": "^3.0.0",
    "jest": "^29.6.1",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/armanvirus/albasari-competetions.git"
  },
  "bugs": {
    "url": "https://github.com/armanvirus/albasari-competetions/issues"
  },
  "homepage": "https://github.com/armanvirus/albasari-competetions#readme"
}
