<!-- Font Awesome CDN -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<div class="container">
    <div class="d-flex">
        <%- include('../partials/nav') %>
        
        <main class="main">
            <div class="banner">
                <h1>Welcome Home!</h1>
                <h2 class="school_name"><%= name %></h2>
                <p>Stay connected with the Albasari community and manage your activities</p>
            </div>
            
            <div class="main_inner">
                <div class="items_container">
                    <h3><i class="fas fa-chart-line"></i> Dashboard Overview</h3>
                    
                    <div class="dashboard" id="dashboard">
                        <div class="dashboard_top">
                            <div class="dashboard_card" style="background: linear-gradient(135deg, rgb(6, 187, 118), #20c997); color: #fff;">
                                <div class="icon">
                                    <i class="fas fa-layer-group"></i>
                                </div>
                                <div class="detail">
                                    <h1><%= categories %></h1>
                                    <p>Registered Categories</p>
                                </div>
                            </div>
                            
                            <div class="dashboard_card" style="background: linear-gradient(135deg, #17a2b8, #20c997); color: #fff;">
                                <div class="icon">
                                    <i class="fas fa-user-graduate"></i>
                                </div>
                                <div class="detail">
                                    <h1><%= totalStudents %></h1>
                                    <p>Total Students</p>
                                </div>
                            </div>
                           
                            <div class="dashboard_card" style="background: linear-gradient(135deg, #28a745, #20c997); color: #fff;">
                                <div class="icon">
                                    <i class="fas fa-trophy"></i>
                                </div>
                                <div class="detail">
                                    <h1><%= categories %></h1>
                                    <p>Active Programs</p>
                                </div>
                            </div>
                            
                            <div class="dashboard_card" style="background: linear-gradient(135deg, rgb(240, 121, 121), #dc3545); color: #fff;">
                                <div class="icon">
                                    <i class="fas fa-clock"></i>
                                </div>
                                <div class="detail">
                                    <h3>Application Status</h3>
                                    <p style="margin-top: 10px;">Pending Review</p>
                                </div>
                            </div>
                        </div>
                        
                        <div class="dashboard_bottom">
                            <div class="start_app">
                                <a href="/app/application">
                                    <i class="fas fa-plus-circle"></i>
                                    Start New Application
                                </a>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Community Newsfeed Section -->
                    <div class="recent-activity">
                        <h3><i class="fas fa-rss"></i> Community Newsfeed</h3>
                        <p class="newsfeed-description">Stay updated with latest activities from the Albasari community</p>
                        <ul class="activity-list">
                            <% if (newsfeed && newsfeed.length > 0) { %>
                                <% newsfeed.forEach(function(item) { %>
                                    <li class="activity-item newsfeed-item">
                                        <div class="activity-icon <%= item.color %>">
                                            <i class="<%= item.icon %>"></i>
                                        </div>
                                        <div class="activity-content">
                                            <div class="activity-title"><%= item.title %></div>
                                            <div class="activity-description"><%= item.content %></div>
                                            <div class="activity-time">
                                                <% 
                                                    const timeAgo = (new Date() - new Date(item.timestamp)) / (1000 * 60 * 60); 
                                                    if (timeAgo < 1) {
                                                        const minutesAgo = Math.floor(timeAgo * 60);
                                                        if (minutesAgo < 1) { %>
                                                            just now
                                                        <% } else { %>
                                                            <%= minutesAgo %> minute<%= minutesAgo > 1 ? 's' : '' %> ago
                                                        <% }
                                                    } else if (timeAgo < 24) { %>
                                                        <%= Math.floor(timeAgo) %> hour<%= Math.floor(timeAgo) > 1 ? 's' : '' %> ago
                                                    <% } else { %>
                                                        <%= Math.floor(timeAgo / 24) %> day<%= Math.floor(timeAgo / 24) > 1 ? 's' : '' %> ago
                                                    <% } %>
                                            </div>
                                        </div>
                                    </li>
                                <% }); %>
                            <% } else { %>
                                <li class="activity-item">
                                    <div class="activity-icon">
                                        <i class="fas fa-info-circle"></i>
                                    </div>
                                    <div class="activity-content">
                                        <div class="activity-title">Welcome to Albasari!</div>
                                        <div class="activity-description">Start by submitting applications or registering students to see community activities here.</div>
                                        <div class="activity-time">Now</div>
                                    </div>
                                </li>
                            <% } %>
                        </ul>
                        
                        <!-- View More Activities Button -->
                        <div class="newsfeed-actions">
                            <a href="#" class="btn-newsfeed-more" onclick="loadMoreActivities()">
                                <i class="fas fa-chevron-down"></i> View More Activities
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </main>
        
        <%- include('../partials/hamburger.ejs') %>
    </div>
</div>

<script>
    // Enhanced dashboard interactions
    document.addEventListener('DOMContentLoaded', function() {
        // Animate dashboard cards on load
        const cards = document.querySelectorAll('.dashboard_card');
        cards.forEach((card, index) => {
            card.style.animationDelay = `${index * 0.1}s`;
        });
        
        // Add click analytics for dashboard cards
        cards.forEach(card => {
            card.addEventListener('click', function() {
                const cardType = this.querySelector('.detail p').textContent;
                console.log(`Dashboard card clicked: ${cardType}`);
                // Here you could send analytics data
            });
        });
        
        // Mobile menu functionality
        const hamburger = document.querySelector('.hambuger');
        const mainNav = document.querySelector('.main_nav');
        
        if (hamburger && mainNav) {
            hamburger.addEventListener('click', function() {
                hamburger.classList.toggle('active');
                mainNav.classList.toggle('open');
                console.log("Mobile menu toggled");
            });
        }
        
        // Show welcome notification
        setTimeout(() => {
            if (typeof showNotification === 'function') {
                showNotification('Welcome to your dashboard!', 'success');
            }
        }, 1000);
    });

    // Function to load more activities (for future implementation)
    function loadMoreActivities() {
        // This could be enhanced to load more activities via AJAX
        console.log('Loading more activities...');
        
        // For now, show a simple message
        const button = document.querySelector('.btn-newsfeed-more');
        const originalText = button.innerHTML;
        
        button.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Loading...';
        button.style.pointerEvents = 'none';
        
        setTimeout(() => {
            button.innerHTML = originalText;
            button.style.pointerEvents = 'auto';
            
            // Show notification if available
            if (typeof showNotification === 'function') {
                showNotification('All recent activities are already displayed!', 'info');
            } else {
                alert('All recent activities are already displayed!');
            }
        }, 1500);
    }
</script>
